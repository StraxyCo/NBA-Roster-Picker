{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/" }
  ],
  "crons": [
    {
      "path": "/api/sync-rosters",
      "schedule": "0 4 * * 1"
    },
    {
      "path": "/api/sync-careers",
      "schedule": "30 4 * * 1"
    }
  ]
}
